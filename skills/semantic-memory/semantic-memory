#!/usr/bin/env bash
# andenken CLI — semantic memory for humans and AI agents
# Calls the andenken repo's CLI via npx tsx.
#
# Deliberately thin. An absent axis is answered by andenken itself
# (`store.ts` describeAxisAbsence -> cli.ts openAxisForRead, exit 4); this
# wrapper carried a second copy of that gate for one day and it was already the
# weaker of the two — see SKILL.md § "Absent axis".
set -euo pipefail

# Load API keys
[[ -f "${HOME}/.env.local" ]] && source "${HOME}/.env.local"

ANDENKEN_DIR="${HOME}/repos/gh/andenken"

exec npx tsx "${ANDENKEN_DIR}/cli.ts" "$@"
