{
	// 정적 자산만 올린다. 로그인 관문은 Cloudflare Access 앱 "harness-exterior"(harness.junghanacs.com).
	// workers_dev / preview_urls 는 반드시 false — 켜면 Access 밖의 주소가 생긴다.
	"name": "harness-exterior",
	"compatibility_date": "2026-11-01",
	"workers_dev": false,
	"preview_urls": false,
	"assets": { "directory": "./public" },
	"routes": [{ "pattern": "harness.junghanacs.com", "custom_domain": true }]
}
