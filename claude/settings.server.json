{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Grep",
      "Glob",
      "WebFetch",
      "WebSearch",
      "Skill",
      "mcp__entwurf-bridge__*"
    ],
    "deny": [
      "Agent",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "Monitor",
      "NotebookEdit",
      "PushNotification",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/junghan/.claude/hooks/session-info.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/junghan/.claude/hooks/agent-notify.sh claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "agent-sdk-dev@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "atlassian@claude-plugins-official": false,
    "telegram@claude-plugins-official": false
  },
  "skillOverrides": {
    "claude-api": "off"
  },
  "language": "Korean",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "normal",
  "preferredNotifChannel": "notifications_disabled",
  "agentPushNotifEnabled": true,
  "voiceEnabled": false,
  "autoUpdates": true,
  "remoteControlAtStartup": false,
  "outputStyle": "Concise"
}
