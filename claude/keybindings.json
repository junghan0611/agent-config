{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Chat",
      "bindings": {
        "ctrl+j": "chat:newline",
        "shift+enter": "chat:newline",
        "ctrl+/": "chat:undo"
      }
    },
    {
      "context": "Autocomplete",
      "bindings": {
        "alt+j": "autocomplete:next",
        "alt+k": "autocomplete:previous",
        "ctrl+n": "autocomplete:next",
        "ctrl+p": "autocomplete:previous"
      }
    },
    {
      "context": "Scroll",
      "bindings": {
        "meta+u": "scroll:halfPageUp",
        "meta+v": "scroll:halfPageDown",
        "meta+<": "scroll:top",
        "meta+>": "scroll:bottom",
        "meta+shift+,": "scroll:top",
        "meta+shift+.": "scroll:bottom"
      }
    }
  ]
}
